# Copy to .env and fill in your values (never commit .env)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TRADING_SYMBOL=PAXG/USDT
TRADING_TIMEFRAME=4h

# Select the market-data source. Binance remains the default.
PRICE_SOURCE=binance

# AI Gold Trading Analyst (DAILY_OUTLOOK). Stays disabled until an API key
# is provisioned, independent of the cron entry also being commented out.
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: give the AI pipeline its own market-data source/symbol,
# independent of PRICE_SOURCE/TRADING_SYMBOL above (which the strategy and
# liquidity-sweep pipelines keep using unchanged). Leave both unset to make
# the AI pipeline follow PRICE_SOURCE/TRADING_SYMBOL like everything else.
AI_PRICE_SOURCE=
AI_TRADING_SYMBOL=
# Required only when AI_PRICE_SOURCE=twelvedata (or PRICE_SOURCE=twelvedata).
TWELVEDATA_API_KEY=

# MySQL XAU/USD support/resistance alert. The job reads table `price_alert`
# (`date` DATETIME, `symbol`, `support`, `resistance`) for XAUUSD only.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional: adds recently-released US macro data (CPI, NFP, unemployment,
# Fed funds rate, PCE) as background context for the AI pipeline. FRED gives
# actual/previous values only — no forecast figures, no forward-looking
# calendar. Leave unset to omit macro data entirely; the pipeline still runs.
FRED_API_KEY=

# Adds today's scheduled USD high-impact ("red folder") events (forecast,
# previous, scheduled time — no actual/reported value) from a public
# forward-looking calendar feed. No API key needed; set to false to turn it
# off (e.g. if the feed misbehaves) without a redeploy.
AI_NEWS_CALENDAR_ENABLED=true

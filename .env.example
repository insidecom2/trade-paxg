# Copy to .env and fill in your values (never commit .env)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TRADING_SYMBOL=PAXG/USDT
TRADING_TIMEFRAME=4h

# Select the market-data source. Binance remains the default.
PRICE_SOURCE=binance

# AI Gold Trading Analyst (DAILY_OUTLOOK). Stays disabled until an API key
# is provisioned, independent of the cron entry also being commented out.
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: give the AI pipeline its own market-data source/symbol,
# independent of PRICE_SOURCE/TRADING_SYMBOL above (which the strategy and
# liquidity-sweep pipelines keep using unchanged). Leave both unset to make
# the AI pipeline follow PRICE_SOURCE/TRADING_SYMBOL like everything else.
AI_PRICE_SOURCE=
AI_TRADING_SYMBOL=
# Required only when AI_PRICE_SOURCE=twelvedata (or PRICE_SOURCE=twelvedata).
TWELVEDATA_API_KEY=

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=UTC

# Run at the start and end of the London-New York overlap, four hours apart.
0 13,17 * * 1-5 app cd /app && /usr/local/bin/python main.py --symbol "${TRADING_SYMBOL:-PAXG/USDT}" --timeframe "${TRADING_TIMEFRAME:-4h}" >> /proc/1/fd/1 2>> /proc/1/fd/2
